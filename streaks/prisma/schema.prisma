datasource db {
    provider = "postgresql"
    // url      = env("DATABASE_URL")
}

generator client {
    provider    = "prisma-client-js"
    // output   = "../src/generated"  // relative to prisma/schema.prisma
    // no output → defaults to node_modules/@prisma/client
}

model UserStreak {
    userId          String  @id
    currentStreak   Int
    longestStreak   Int
    lastActiveDate  DateTime
    updatedAt       DateTime    @updatedAt
}

model ProcessedEvent {
    eventId         String  @id
    processedAt    DateTime    @default(now())
}