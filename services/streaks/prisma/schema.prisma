datasource db {
    provider = "postgresql"
}

generator client {
    provider    = "prisma-client-js"
}

model UserStreak {
    userId          String  @id
    currentStreak   Int
    longestStreak   Int
    lastActiveDate  DateTime
    updatedAt       DateTime    @updatedAt
}

model ProcessedEvent {
    eventId         String  @id
    processedAt    DateTime    @default(now())
}